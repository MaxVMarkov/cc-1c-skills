{
  "name": "Реквизиты СУБД при файловой базе — отказ, а не молчаливая потеря",
  "preRun": [
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    },
    {
      "writeFile": {
        "path": "ib/1Cv8.1CD",
        "content": "stub"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\ibcmd.cmd",
    "-InfoBasePath",
    "{workDir}\\ib",
    "-Dbms",
    "MSSQLServer",
    "-DbServer",
    "dbhost",
    "-DbName",
    "dbname",
    "-OutputFile",
    "{workDir}\\out.cf"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": "apply to a server base"
  },
  "noSnapshot": "негативный кейс — навык отказывает до вызова платформы",
  "osOnly": "win32"
}
