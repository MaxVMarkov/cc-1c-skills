{
  "name": "infobase config load — серверная база по явным реквизитам СУБД, вместо --db-path идут --dbms/--db-server/--db-name",
  "preRun": [
    {
      "writeFile": {
        "path": "in.cf",
        "content": "stub"
      }
    },
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/ibcmd.cmd",
    "-InfoBaseServer",
    "srv01",
    "-InfoBaseRef",
    "MyDB",
    "-Dbms",
    "MSSQLServer",
    "-DbServer",
    "dbhost",
    "-DbName",
    "dbname",
    "-InputFile",
    "{workDir}/in.cf"
  ],
  "expect": {
    "stdoutContains": [
      "ARGS: infobase config load",
      "--dbms=MSSQLServer",
      "--db-server=dbhost",
      "--db-name=dbname"
    ],
    "stdoutNotContains": [
      "--db-path"
    ]
  },
  "noSnapshot": "проверяется сборка команды ibcmd для серверной базы; файл выгрузки — фикстура кейса",
  "osOnly": "win32"
}
