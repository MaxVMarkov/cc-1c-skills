{
  "name": "infobase config load — отказ: их читает только ibcmd",
  "preRun": [
    {
      "writeFile": {
        "path": "in.cf",
        "content": "stub"
      }
    },
    {
      "writeFile": {
        "path": "1cv8.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/1cv8.cmd",
    "-InfoBaseServer",
    "srv01",
    "-InfoBaseRef",
    "MyDB",
    "-Dbms",
    "MSSQLServer",
    "-DbServer",
    "dbhost",
    "-DbName",
    "dbname",
    "-InputFile",
    "{workDir}/in.cf"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "used by ibcmd only",
      "the selected engine is 1cv8"
    ]
  },
  "noSnapshot": "негативный кейс — конфигуратор берёт серверную базу из /S server/ref, реквизиты СУБД ему не нужны",
  "osOnly": "win32"
}
