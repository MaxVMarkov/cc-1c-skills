{
  "name": "infobase config import — отказ: без базы сборка идёт в файловую заглушку",
  "preRun": [
    {
      "writeFile": {
        "path": "src/ext.xml",
        "content": "<epf/>"
      }
    },
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}/ibcmd.cmd",
    "-Dbms",
    "MSSQLServer",
    "-DbServer",
    "dbhost",
    "-DbName",
    "dbname",
    "-SourceFile",
    "{workDir}/src/ext.xml",
    "-OutputFile",
    "{workDir}/out/ext.epf"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "describe a server infobase",
      "temporary file stub base"
    ]
  },
  "noSnapshot": "негативный кейс — навык отказывает до вызова платформы",
  "osOnly": "win32"
}
