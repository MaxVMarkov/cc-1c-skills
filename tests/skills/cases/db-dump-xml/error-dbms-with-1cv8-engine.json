{
  "name": "Реквизиты СУБД при движе 1cv8 — отказ: их читает только ibcmd",
  "preRun": [
    {
      "writeFile": {
        "path": "1cv8.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    },
    {
      "writeFile": {
        "path": "out/ConfigDumpInfo.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ConfigDumpInfo format=\"Hierarchical\" version=\"2.17\"/>"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\1cv8.cmd",
    "-InfoBaseServer",
    "srv01",
    "-InfoBaseRef",
    "MyDB",
    "-Dbms",
    "MSSQLServer",
    "-DbServer",
    "dbhost",
    "-DbName",
    "dbname",
    "-ConfigDir",
    "{workDir}\\out",
    "-Mode",
    "Full"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "used by ibcmd only",
      "the selected engine is 1cv8"
    ]
  },
  "noSnapshot": "негативный кейс — конфигуратор берёт серверную базу из /S server/ref, реквизиты СУБД ему не нужны",
  "osOnly": "win32"
}
