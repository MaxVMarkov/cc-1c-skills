{
  "name": "Неизвестный вид СУБД в блоке dbms — отказ с перечислением допустимых, а не непостижимая ошибка ibcmd",
  "cwd": "workDir",
  "preRun": [
    {
      "writeFile": {
        "path": ".v8-project.json",
        "content": "{\n  \"databases\": [\n    {\n      \"id\": \"srv\",\n      \"type\": \"server\",\n      \"server\": \"srv01\",\n      \"ref\": \"MyDB\",\n      \"dbms\": { \"kind\": \"MySQL\", \"server\": \"h\", \"name\": \"n\" }\n    }\n  ]\n}"
      }
    },
    {
      "writeFile": {
        "path": "ibcmd.cmd",
        "content": "@echo off\r\necho ARGS: %*\r\nexit /b 0\r\n",
        "executable": true
      }
    },
    {
      "writeFile": {
        "path": "out/ConfigDumpInfo.xml",
        "content": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><ConfigDumpInfo format=\"Hierarchical\" version=\"2.17\"/>"
      }
    }
  ],
  "args_extra": [
    "-V8Path",
    "{workDir}\\ibcmd.cmd",
    "-InfoBaseServer",
    "srv01",
    "-InfoBaseRef",
    "MyDB",
    "-ConfigDir",
    "{workDir}\\out",
    "-Mode",
    "Full"
  ],
  "expectError": true,
  "expect": {
    "stdoutContains": [
      "unknown DBMS kind 'MySQL'",
      "MSSQLServer, PostgreSQL, IBMDB2, OracleDatabase"
    ]
  },
  "noSnapshot": "негативный кейс — вид отсеивается на разборе реквизитов",
  "osOnly": "win32"
}
