// ==== пакетная декомпиляция закрытых модулей (без участия человека) =========
// Две строки манифеста: "<путь.image>|<путь.bsl>" — чистым кодом 1С (бэкенд
// Ассемблера), "<путь.image>|<путь.bsl>|addin" — через x64-компоненту
// Deobfuscator1С. Компоненту платформа разрешает подключать только на клиенте,
// поэтому аддин-бэкенд живёт в клиентском коде, а весь файловый ввод-вывод
// остаётся на сервере: тонкому клиенту не нужны локальные файлы и диалог
// безопасности не появляется. Вызовы на сервер stateless.

&НаКлиенте
Перем АддинОбъект;

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Попытка
		Попытка
			// Компонента подключается из управляемой формы — без этого тонкий
			// клиент спросит разрешения и головной запуск встанет.
			ЭтаФорма.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях = Ложь;
		Исключение
		КонецПопытки;
		Список = ПакетСписокНаСервере(КаталогОбмена() + "manifest.txt");
		Строки = РазобратьПоРазделителю(Список, Символы.ПС);
		Для Номер = 1 По Строки.Количество() Цикл
			ПакетОдин(Номер, Строки[Номер - 1]);
		КонецЦикла;
	Исключение
		ПакетНаСервереНеудача("Исключение клиента: " + ОписаниеОшибки());
	КонецПопытки;
	ЗавершитьРаботуСистемы(Ложь, Ложь);
КонецПроцедуры

&НаКлиенте
Процедура ПакетОдин(Знач Номер, Знач СтрокаМанифеста)
	Разбор = РазобратьСтрокуМанифеста(СтрокаМанифеста);
	Если Разбор = Неопределено Тогда
		ОтметитьНаСервере(СтрШаблон("BAD|%1|нет разделителя", Формат(Номер, "ЧГ=0")));
		Возврат;
	КонецЕсли;
	Если НРег(Разбор[2]) = "addin" Тогда
		Если АддинОбъект = Неопределено Тогда
			ПодключитьАддин();
		КонецЕсли;
		ПакетОдинЧерезАддин(Номер, Разбор);
		Иначе
		ПакетОдинНаСервере(Номер, СтрокаМанифеста);
	КонецЕсли;
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция РазобратьСтрокуМанифеста(Знач СтрокаМанифеста)
	Позиция = СтрНайти(СтрокаМанифеста, "|");
	Если Позиция = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	Результат = Новый Массив;
	Результат.Добавить(Лев(СтрокаМанифеста, Позиция - 1));
	Остаток = Сред(СтрокаМанифеста, Позиция + 1);
	Позиция2 = СтрНайти(Остаток, "|");
	Если Позиция2 = 0 Тогда
		Результат.Добавить(Остаток);
		Результат.Добавить("bsl");
		Иначе
		Результат.Добавить(Лев(Остаток, Позиция2 - 1));
		Результат.Добавить(НРег(СокрЛП(Сред(Остаток, Позиция2 + 1))));
	КонецЕсли;
	Возврат Результат;
КонецФункции

&НаКлиенте
Процедура ПодключитьАддин()
	ЗаписатьЛогНаСервере("=== подключаем " + ПутьКомпоненты());
	ЗаписатьЛогНаСервере("предупреждения об опасных действиях: " + ОпасныеДействияТекст());
	Успех = Ложь;
	Попытка
		Успех = ПодключитьВнешнююКомпоненту(ПутьКомпоненты(), ИмяПлагина(),
			ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.НеИзолированно);
		ЗаписатьЛогНаСервере("по пути клиента: " + ?(Успех, "истина", "ложь"));
	Исключение
		ЗаписатьЛогНаСервере("по пути клиента: исключение " + ОписаниеОшибки());
	КонецПопытки;
	Если Не Успех Тогда
		Попытка
			// Клиент может не иметь доступа к локальным файлам — тогда берём файл
			// через временное хранилище сервера.
			Адрес = АдресФайлаНаСервере(ПутьКомпоненты());
			Успех = ПодключитьВнешнююКомпоненту(Адрес, ИмяПлагина(),
				ТипВнешнейКомпоненты.Native, ТипПодключенияВнешнейКомпоненты.НеИзолированно);
			ЗаписатьЛогНаСервере("по адресу хранилища: " + ?(Успех, "истина", "ложь"));
		Исключение
			ЗаписатьЛогНаСервере("по адресу хранилища: исключение " + ОписаниеОшибки());
		КонецПопытки;
	КонецЕсли;
	Если Не Успех Тогда
		ВызватьИсключение "компонента не подключилась: " + ПутьКомпоненты();
	КонецЕсли;
	АддинОбъект = Новый("AddIn." + ИмяПлагина() + ".Deobfuscator1С");
	ЗаписатьЛогНаСервере("компонента подключена");
КонецПроцедуры

&НаКлиенте
Функция ОпасныеДействияТекст()
	Попытка
		Возврат ?(ЭтаФорма.ЗащитаОтОпасныхДействий.ПредупреждатьОбОпасныхДействиях, "включены", "выключены");
	Исключение
		Возврат "свойство недоступно";
	КонецПопытки;
КонецФункции

&НаКлиенте
Процедура ПакетОдинЧерезАддин(Знач Номер, Знач Разбор)
	ПутьImage = Разбор[0];
	ПутьBSL = Разбор[1];
	Попытка
		ЗаписатьЛогНаСервере("=== " + ПутьImage);
		БайтКод = ПрочитатьКакСтрокуНаСервере(ПутьImage);
		Если БайтКод = Неопределено Тогда
			ВызватьИсключение "image не читается: " + ПутьImage;
		КонецЕсли;
		Текст = "";
		Попытка
			Текст = АддинОбъект.Декомпилировать(БайтКод, "", Ложь, "");
		Исключение
			Текст = "";
		КонецПопытки;
		ЗаписатьЛогНаСервере("прямая декомпиляция: длина=" + Формат(СтрДлина(Текст), "ЧГ=0")
			+ " ошибка=" + ТекстОшибкиАддина());
		Если ПустаяСтрока(Текст) Тогда
			Текст = ПочиститьИДекомпилировать(БайтКод);
		КонецЕсли;
		Если ПустаяСтрока(Текст) Тогда
			ВызватьИсключение "аддин вернул пустой текст; ошибка=" + ТекстОшибкиАддина();
		КонецЕсли;
		ЗаписатьКакСтрокуНаСервере(ПутьBSL, Текст);
		ОтметитьНаСервере(СтрШаблон("OK|%1|%2|%3",
			Формат(Номер, "ЧГ=0"), Формат(СтрДлина(Текст), "ЧГ=0"), ПутьBSL));
	Исключение
		ОтметитьНаСервере(СтрШаблон("ERR|%1|%2|%3",
			Формат(Номер, "ЧГ=0"), ПутьBSL, ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

// Поставщик деобфусцирует по блокам: сначала пробуем целиком, затем каждый
// именованный блок из ИменаБлоков() отдельно, с принудительной нумерацией строк.

&НаКлиенте
Функция ПочиститьИДекомпилировать(Знач БайтКод)
	Блоки = Новый Массив;
	Блоки.Добавить("");
	Попытка
		Имена = АддинОбъект.ИменаБлоков(БайтКод);
		Если ТипЗнч(Имена) = Тип("Строка") Тогда
			Для Каждого ИмяБлока Из РазобратьСписокИмен(Имена) Цикл
				Если Блоки.Найти(ИмяБлока) = Неопределено Тогда
					Блоки.Добавить(ИмяБлока);
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
	Исключение
	КонецПопытки;
	ЗаписатьЛогНаСервере("блоков для чистки: " + Формат(Блоки.Количество(), "ЧГ=0"));
	Для Каждого БлокДляДеобфускации Из Блоки Цикл
		Попытка
			Чистый = АддинОбъект.Деобфусцировать(БайтКод, "", БлокДляДеобфускации);
			Если Не ПустаяСтрока(Чистый) Тогда
				Текст = АддинОбъект.Декомпилировать(Чистый, "", Истина, БлокДляДеобфускации);
				ЗаписатьЛогНаСервере("блок """ + БлокДляДеобфускации + """: длина="
					+ Формат(СтрДлина(Текст), "ЧГ=0") + " ошибка=" + ТекстОшибкиАддина());
				Если Не ПустаяСтрока(Текст) Тогда
					Возврат Текст;
				КонецЕсли;
			КонецЕсли;
		Исключение
			ЗаписатьЛогНаСервере("блок """ + БлокДляДеобфускации + """: " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	Возврат "";
КонецФункции

&НаКлиенте
Функция ТекстОшибкиАддина()
	Попытка
		Ошибка = АддинОбъект.ТекстПоследнейОшибки();
		Если Ошибка = Неопределено Тогда
			Возврат "не определена";
		КонецЕсли;
		Возврат Ошибка;
	Исключение
		Возврат "нечитаема";
	КонецПопытки;
КонецФункции

// ИменаБлоков отдаёт JSON вида {"names":[{"name":"ИмяБлока"},...]}.

&НаКлиентеНаСервереБезКонтекста
Функция РазобратьСписокИмен(Знач Текст)
	Результат = Новый Массив;
	Позиция = 1;
	Шаг = СтрДлина("""name""");
	Пока Истина Цикл
		Найдено = СтрНайти(Текст, """name""", НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Прервать;
		КонецЕсли;
		Начало = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Найдено + Шаг + 1);
		Если Начало = 0 Тогда
			Прервать;
		КонецЕсли;
		Конец = СтрНайти(Текст, """", НаправлениеПоиска.СНачала, Начало + 1);
		Если Конец = 0 Тогда
			Прервать;
		КонецЕсли;
		Имя = Сред(Текст, Начало + 1, Конец - Начало - 1);
		Если Не ПустаяСтрока(Имя) Тогда
			Результат.Добавить(Имя);
		КонецЕсли;
		Позиция = Конец + 1;
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция КаталогОбмена()
	Возврат "C:\Users\Public\deobf\";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ИмяПлагина()
	Возврат "Deobfuscator1СCurrent";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Функция ПутьКомпоненты()
	Возврат КаталогОбмена() + "WebExDeobfuscator1CWin64_1002.dll";
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура ЗаписатьСтрокуЛога(Знач ПутьЛога, Знач ТекстСтроки)
	Запись = Новый ЗаписьТекста(ПутьЛога, КодировкаТекста.UTF8, Символы.ПС, Истина);
	Запись.Записать(ТекстСтроки + Символы.ПС);
	Запись.Закрыть();
КонецПроцедуры

&НаСервере
Процедура ОтметитьНаСервере(Знач ТекстСтроки)
	ЗаписатьСтрокуЛога(КаталогОбмена() + "_report.log", ТекстСтроки);
КонецПроцедуры

&НаСервере
Процедура ЗаписатьЛогНаСервере(Знач ТекстСтроки)
	ЗаписатьСтрокуЛога(КаталогОбмена() + "addin.log", ТекстСтроки);
КонецПроцедуры

&НаСервере
Функция АдресФайлаНаСервере(Знач Путь)
	Возврат ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(Путь), Новый УникальныйИдентификатор);
КонецФункции

&НаСервере
Функция ПрочитатьКакСтрокуНаСервере(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Если Чтение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Текст;
КонецФункции

&НаСервере
Процедура ЗаписатьКакСтрокуНаСервере(Знач Путь, Знач Текст)
	Запись = Новый ЗаписьТекста(Путь, КодировкаТекста.UTF8);
	Запись.Записать(Текст);
	Запись.Закрыть();
КонецПроцедуры

&НаКлиенте
Функция РазобратьПоРазделителю(Знач Строка, Знач Разделитель)
	Результат = Новый Массив;
	Позиция = 1;
	Пока Позиция <= СтрДлина(Строка) Цикл
		Найдено = СтрНайти(Строка, Разделитель, НаправлениеПоиска.СНачала, Позиция);
		Если Найдено = 0 Тогда
			Результат.Добавить(Сред(Строка, Позиция));
			Прервать;
		КонецЕсли;
		Результат.Добавить(Сред(Строка, Позиция, Найдено - Позиция));
		Позиция = Найдено + СтрДлина(Разделитель);
	КонецЦикла;
	Возврат Результат;
КонецФункции

&НаСервере
Функция ПакетСписокНаСервере(Знач ПутьМанифеста)
	ПутьЛога = КаталогОбмена() + "boot.log";
	ЗаписатьСтрокуЛога(ПутьЛога, "старт, манифест " + ПутьМанифеста);
	Попытка
		Чтение = Новый ЧтениеТекста(ПутьМанифеста, КодировкаТекста.UTF8);
	Исключение
		ЗаписатьСтрокуЛога(ПутьЛога, "не открыт манифест: " + ОписаниеОшибки());
		Возврат "";
	КонецПопытки;
	Если Чтение = Неопределено Тогда
		ЗаписатьСтрокуЛога(ПутьЛога, "манифест не открыт (файла нет)");
		Возврат "";
	КонецЕсли;
	Строки = Новый Массив;
	Пока Истина Цикл
		Строка = Чтение.ПрочитатьСтроку();
		Если Строка = Неопределено Тогда
			Прервать;
		КонецЕсли;
		Строка = СокрЛП(Строка);
		Если ПустаяСтрока(Строка) Тогда
			Продолжить;
		КонецЕсли;
		Строки.Добавить(Строка);
	КонецЦикла;
	Чтение.Закрыть();
	ЗаписатьСтрокуЛога(ПутьЛога, "манифест прочитан, модулей: " + Формат(Строки.Количество(), "ЧГ=0"));
	Возврат СтрСоединить(Строки, Символы.ПС);
КонецФункции

&НаСервере
Процедура ПакетОдинНаСервере(Знач Номер, Знач СтрокаМанифеста)
	ПутьОтчета = КаталогОбмена() + "_report.log";
	Позиция = СтрНайти(СтрокаМанифеста, "|");
	Если Позиция = 0 Тогда
		ЗаписатьСтрокуЛога(ПутьОтчета, СтрШаблон("BAD|%1|нет разделителя", Формат(Номер, "ЧГ=0")));
		Возврат;
	КонецЕсли;
	ПутьImage = Лев(СтрокаМанифеста, Позиция - 1);
	Остаток = Сред(СтрокаМанифеста, Позиция + 1);
	Режим = "bsl";
	Позиция2 = СтрНайти(Остаток, "|");
	Если Позиция2 > 0 Тогда
		ПутьBSL = Лев(Остаток, Позиция2 - 1);
		Режим = НРег(СокрЛП(Сред(Остаток, Позиция2 + 1)));
	Иначе
		ПутьBSL = Остаток;
	КонецЕсли;
	Попытка
		Если Режим = "ADDIN" Тогда
			ЗаписатьСтрокуЛога(ПутьОтчета, СтрШаблон("ERR|%1|%2|аддин подключается на клиенте",
				Формат(Номер, "ЧГ=0"), ПутьBSL));
			Возврат;
		КонецЕсли;
		ОткрытьФайлНаСервере(ПутьImage);
		ДекомпиляцияНаСервере();
		Текст = ТекстМодуля.ПолучитьТекст();
		ТекстМодуля.Очистить();
		Запись = Новый ЗаписьТекста(ПутьBSL, КодировкаТекста.UTF8);
		Запись.Записать(Текст);
		Запись.Закрыть();
		ЗаписатьСтрокуЛога(ПутьОтчета, СтрШаблон("OK|%1|%2|%3",
			Формат(Номер, "ЧГ=0"),
			Формат(СтрДлина(Текст), "ЧГ=0"),
			ПутьBSL));
	Исключение
		ЗаписатьСтрокуЛога(ПутьОтчета, СтрШаблон("ERR|%1|%2|%3",
			Формат(Номер, "ЧГ=0"), ПутьBSL, ОписаниеОшибки()));
	КонецПопытки;
КонецПроцедуры

&НаСервере
Процедура ПакетНаСервереНеудача(Знач ТекстОшибки)
	ЗаписатьСтрокуЛога(КаталогОбмена() + "boot.log", ТекстОшибки);
КонецПроцедуры

// Аналог ПрочитатьМодуль()/ОткрытьНаСервере() из исходника, но читает image
// напрямую с диска: исходник берёт содержимое из формы, а нам нужен вызов без
// участия человека.

&НаСервере
Функция ПрочитатьМодульИзФайлаНаСервере(Знач Путь)
	Чтение = Новый ЧтениеТекста(Путь, КодировкаТекста.UTF8);
	Если Чтение = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Текст = Чтение.Прочитать();
	Чтение.Закрыть();
	Возврат Parse(Текст);
КонецФункции

&НаСервере
Процедура ОткрытьФайлНаСервере(Знач Путь)
	Операции.Очистить();
	ЭтаФорма.Константы.Очистить();
	Переменные.Очистить();
	Процедуры.Очистить();
	РезультатРазбора = ПрочитатьМодульИзФайлаНаСервере(Путь);
	Если РезультатРазбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Для Сч = 1 По РезультатРазбора.ВГраница() Цикл
		Блок = РезультатРазбора[Сч];
		Если Блок[0] = """Cmd""" Тогда
			ЗаполнитьОперации(Блок);
		ИначеЕсли Блок[0] = """Const""" Тогда
			ЗаполнитьКонстанты(Блок);
		ИначеЕсли Блок[0] = """Var""" Тогда
			ЗаполнитьПеременные(Блок, Переменные);
		ИначеЕсли Блок[0] = """Proc""" Тогда
			ЗаполнитьПроцедуры(Блок);
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры
